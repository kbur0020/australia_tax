{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "A 69-fold gap, in the same country",
    "subtitle": ["Top 10 vs bottom 10 Australian postcodes by average taxable income, 2022-23.", "Source: ATO Taxation Statistics 2022-23, Snapshot Table 7A."],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": 600,
    "subtitleFontSize": 12,
    "subtitleColor": "#5a5a5a",
    "offset": 12
  },
  "width": 720,
  "height": 460,
  "background": "transparent",
  "data": {"url": "data/ato_top_bottom_10_australia.csv"},
  "config": {
    "font": "Source Sans 3, Source Sans Pro, sans-serif",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 11, "titleFontSize": 12, "titleFontWeight": 500, "labelColor": "#3a3a3a"}
  },
  "transform": [
    {"calculate": "datum.suburb + ' (' + datum.postcode + ', ' + datum.state + ')'", "as": "label"},
    {"calculate": "datum.rank_type == 'Top' ? datum.avg_taxable_income : -datum.avg_taxable_income", "as": "diverging_value"}
  ],
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": {"field": "diverging_value", "order": "descending"},
      "axis": null
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 2, "height": 22},
      "encoding": {
        "x": {
          "field": "diverging_value",
          "type": "quantitative",
          "axis": {
            "title": "Average taxable income (AUD)",
            "values": [-50000, 0, 100000, 200000, 300000],
            "labelExpr": "abs(datum.value) >= 1000 ? '$' + (abs(datum.value)/1000) + 'K' : '$' + abs(datum.value)"
          }
        },
        "color": {
          "field": "rank_type",
          "type": "nominal",
          "scale": {"domain": ["Top", "Bottom"], "range": ["#2d5e3f", "#a8302f"]},
          "legend": {"title": null, "orient": "bottom-right", "labelFontSize": 11, "offset": 8}
        },
        "tooltip": [
          {"field": "rank_type", "title": "Group"},
          {"field": "rank", "title": "Rank within group"},
          {"field": "suburb", "title": "Suburb"},
          {"field": "postcode", "title": "Postcode"},
          {"field": "state", "title": "State"},
          {"field": "avg_taxable_income", "title": "Avg income", "format": "$,.0f"},
          {"field": "median_taxable_income", "title": "Median income", "format": "$,.0f"},
          {"field": "individuals", "title": "Tax filers", "format": ",d"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 10, "fontWeight": 500, "color": "#1a1a1a"},
      "encoding": {
        "x": {"datum": 0, "type": "quantitative"},
        "text": {"field": "label"},
        "align": {
          "condition": {"test": "datum.rank_type == 'Top'", "value": "right"},
          "value": "left"
        },
        "dx": {
          "condition": {"test": "datum.rank_type == 'Top'", "value": -6},
          "value": 6
        }
      }
    },
    {
      "mark": {"type": "text", "fontSize": 10, "fontWeight": 700, "color": "#ffffff", "stroke": "#1a1a1a", "strokeWidth": 0.4},
      "encoding": {
        "x": {"field": "diverging_value", "type": "quantitative"},
        "text": {"field": "avg_taxable_income", "format": "$,.0f"},
        "align": {
          "condition": {"test": "datum.rank_type == 'Top'", "value": "right"},
          "value": "left"
        },
        "dx": {
          "condition": {"test": "datum.rank_type == 'Top'", "value": -6},
          "value": 6
        }
      }
    }
  ]
}
