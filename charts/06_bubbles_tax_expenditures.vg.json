{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "$269 billion the government chose not to collect",
    "subtitle": ["Each circle is one tax concession; size = revenue forgone in 2025-26 ($m).", "Source: Australian Treasury, Tax Expenditures and Insights Statement 2025-26, Table 1.2."],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": 600,
    "subtitleFontSize": 12,
    "subtitleColor": "#5a5a5a",
    "offset": 12
  },
  "width": 720,
  "height": 480,
  "padding": {"left": 10, "right": 10, "top": 10, "bottom": 28},
  "background": "transparent",
  "config": {
    "font": "Source Sans 3, Source Sans Pro, sans-serif",
    "view": {"stroke": null}
  },
  "data": {"url": "data/teis_large_tax_expenditures.csv"},
  "transform": [
    {"filter": "datum.revenue_forgone_m > 0"}
  ],
  "mark": {"type": "circle", "opacity": 0.78, "stroke": "#fbf8f2", "strokeWidth": 1.5},
  "encoding": {
    "x": {
      "field": "tax_type",
      "type": "nominal",
      "sort": ["Super", "CGT", "Income", "Deductions", "GST", "FBT", "Other"],
      "axis": {
        "title": "Tax type",
        "titleFontSize": 12,
        "titleFontWeight": 500,
        "titlePadding": 20,
        "labelFontSize": 12,
        "labelFontWeight": 600,
        "labelPadding": 8,
        "domain": false,
        "ticks": false,
        "orient": "bottom"
      }
    },
    "y": {
      "field": "revenue_forgone_m",
      "type": "quantitative",
      "axis": {"title": "Revenue forgone (AUD millions)", "format": ",d", "labelExpr": "'$' + (datum.value/1000) + 'B'"}
    },
    "size": {
      "field": "revenue_forgone_m",
      "type": "quantitative",
      "scale": {"range": [40, 4500]},
      "legend": null
    },
    "color": {
      "field": "tax_type",
      "type": "nominal",
      "scale": {
        "domain": ["Super", "CGT", "Income", "Deductions", "GST", "FBT", "Other"],
        "range": ["#2d5e3f", "#a8302f", "#1f4530", "#4a7a5a", "#7a9e87", "#c4a37a", "#9a9a9a"]
      },
      "legend": null
    },
    "tooltip": [
      {"field": "title", "title": "Tax expenditure"},
      {"field": "code", "title": "Code"},
      {"field": "tax_type", "title": "Type"},
      {"field": "revenue_forgone_m", "title": "Revenue forgone ($m)", "format": ",d"},
      {"field": "avg_growth_2122_2425_pct", "title": "Avg growth 21-22 to 24-25 (%)"},
      {"field": "projected_growth_pct", "title": "Projected growth (%)"},
      {"field": "distributional_analysis_included", "title": "In distributional analysis"}
    ]
  }
}
