{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The gendered shape of tax concessions",
    "subtitle": ["Average benefit per recipient, men vs women. The wider the gap, the more men gain on average.", "The CGT discount has the largest absolute gap: men receive $5,080 more on average. Source: Australian Treasury, TEIS 2025-26, Table 2.1."],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": 600,
    "subtitleFontSize": 12,
    "subtitleColor": "#5a5a5a",
    "offset": 12
  },
  "width": 600,
  "height": 440,
  "background": "transparent",
  "config": {
    "font": "Source Sans 3, Source Sans Pro, sans-serif",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 11, "titleFontSize": 12, "titleFontWeight": 500, "labelColor": "#3a3a3a"}
  },
  "data": {"url": "data/teis_gender_distribution.csv"},
  "transform": [
    {"filter": "datum.type == 'benefit'"}
  ],
  "encoding": {
    "y": {
      "field": "concession",
      "type": "nominal",
      "sort": {"field": "avg_men", "order": "descending"},
      "axis": {"title": null, "labelLimit": 240, "labelFontSize": 11}
    }
  },
  "layer": [
    {
      "mark": {"type": "rule", "stroke": "#c4a37a", "strokeWidth": 2.5, "opacity": 0.75},
      "encoding": {
        "x": {"field": "avg_men", "type": "quantitative", "axis": {"title": "Average benefit per recipient (AUD, log scale)", "format": "$,d", "labelExpr": "datum.value >= 1000 ? '$' + (datum.value/1000) + 'K' : '$' + datum.value"}, "scale": {"type": "log", "domain": [200, 30000]}},
        "x2": {"field": "avg_women"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 220, "stroke": "#fbf8f2", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "avg_men", "type": "quantitative", "scale": {"type": "log"}},
        "color": {"value": "#1a3a5c"},
        "tooltip": [
          {"field": "concession", "title": "Concession"},
          {"field": "avg_men", "title": "Avg benefit (men, $)", "format": ",d"},
          {"field": "avg_women", "title": "Avg benefit (women, $)", "format": ",d"},
          {"field": "share_men_pct", "title": "Men share of total (%)"},
          {"field": "share_women_pct", "title": "Women share of total (%)"}
        ]
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 220, "stroke": "#fbf8f2", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "avg_women", "type": "quantitative", "scale": {"type": "log"}},
        "color": {"value": "#c1502e"},
        "tooltip": [
          {"field": "concession", "title": "Concession"},
          {"field": "avg_men", "title": "Avg benefit (men, $)", "format": ",d"},
          {"field": "avg_women", "title": "Avg benefit (women, $)", "format": ",d"},
          {"field": "share_men_pct", "title": "Men share of total (%)"},
          {"field": "share_women_pct", "title": "Women share of total (%)"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 10, "fontWeight": 600, "color": "#1a3a5c", "dy": -14, "align": "center"},
      "transform": [{"filter": "datum.concession == 'CGT discount for individuals and trusts'"}],
      "encoding": {
        "x": {"field": "avg_men", "type": "quantitative", "scale": {"type": "log"}},
        "text": {"value": "Men"}
      }
    },
    {
      "mark": {"type": "text", "fontSize": 10, "fontWeight": 600, "color": "#c1502e", "dy": -14, "align": "center"},
      "transform": [{"filter": "datum.concession == 'CGT discount for individuals and trusts'"}],
      "encoding": {
        "x": {"field": "avg_women", "type": "quantitative", "scale": {"type": "log"}},
        "text": {"value": "Women"}
      }
    }
  ]
}
