{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The cost of concessions keeps climbing",
    "subtitle": ["Annual revenue forgone for the three biggest individual tax concessions.", "Combined, they are projected to cost $91.6 billion in 2028-29 — up 44% in seven years.", "Source: Australian Treasury, TEIS 2025-26, Tables 2.2, 2.4, 2.6."],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": 600,
    "subtitleFontSize": 12,
    "subtitleColor": "#5a5a5a",
    "offset": 12
  },
  "width": 660,
  "height": 380,
  "background": "transparent",
  "config": {
    "font": "Source Sans 3, Source Sans Pro, sans-serif",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 11, "titleFontSize": 12, "titleFontWeight": 500, "labelColor": "#3a3a3a"}
  },
  "data": {"url": "data/teis_big3_timeseries.csv"},
  "transform": [
    {"fold": ["super_contributions_m", "super_earnings_m", "cgt_discount_m"], "as": ["concession_key", "value_m"]},
    {"calculate": "datum.concession_key == 'super_contributions_m' ? 'Super contributions concession' : (datum.concession_key == 'super_earnings_m' ? 'Super earnings concession' : 'CGT discount')", "as": "concession"},
    {"calculate": "datum.value_m / 1000", "as": "value_bn"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "color": "#c4a37a", "strokeDash": [4, 4], "opacity": 0.6},
      "encoding": {"x": {"datum": "2024-25"}}
    },
    {
      "mark": {"type": "text", "fontSize": 10, "color": "#7a5a2e", "fontWeight": 500, "dx": 6, "dy": -160, "align": "left"},
      "encoding": {"x": {"datum": "2024-25"}, "text": {"value": "Projections →"}}
    },
    {
      "mark": {"type": "line", "strokeWidth": 3, "interpolate": "monotone"},
      "encoding": {
        "x": {"field": "financial_year", "type": "ordinal", "axis": {"title": "Financial year", "labelAngle": 0}},
        "y": {"field": "value_bn", "type": "quantitative", "axis": {"title": "Annual revenue forgone (AUD billions)", "labelExpr": "'$' + datum.value + 'B'"}},
        "color": {
          "field": "concession",
          "type": "nominal",
          "scale": {"domain": ["Super contributions concession", "Super earnings concession", "CGT discount"], "range": ["#1a3a5c", "#3f6a92", "#c1502e"]},
          "legend": {"title": null, "orient": "top-left", "labelFontSize": 11, "symbolType": "stroke", "symbolStrokeWidth": 3}
        },
        "tooltip": [
          {"field": "financial_year", "title": "Year"},
          {"field": "concession", "title": "Concession"},
          {"field": "value_m", "title": "Revenue forgone ($m)", "format": ",d"},
          {"field": "value_bn", "title": "Revenue forgone ($bn)", "format": ".2f"}
        ]
      }
    },
    {
      "mark": {"type": "circle", "size": 90, "stroke": "#fbf8f2", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "financial_year", "type": "ordinal"},
        "y": {"field": "value_bn", "type": "quantitative"},
        "color": {
          "field": "concession",
          "type": "nominal",
          "scale": {"domain": ["Super contributions concession", "Super earnings concession", "CGT discount"], "range": ["#1a3a5c", "#3f6a92", "#c1502e"]},
          "legend": null
        },
        "tooltip": [
          {"field": "financial_year", "title": "Year"},
          {"field": "concession", "title": "Concession"},
          {"field": "value_m", "title": "Revenue forgone ($m)", "format": ",d"}
        ]
      }
    }
  ]
}
