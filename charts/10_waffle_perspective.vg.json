{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "$269 billion in tax breaks: each square is $2 billion",
    "subtitle": [
      "Compare the tax money the government chose not to collect (top row, red)",
      "with what it actually spent on each major area (in green).",
      "The red row is twice as long as the federal Health budget — and 36 times longer",
      "than the foreign aid budget — every single year.",
      "Sources: Treasury Tax Expenditures Statement 2025-26 and Final Budget Outcome 2024-25."
    ],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": 600,
    "subtitleFontSize": 12,
    "subtitleColor": "#5a5a5a",
    "subtitleLimit": 9999,
    "offset": 12
  },
  "width": 760,
  "height": 220,
  "background": "transparent",
  "padding": {"left": 20, "right": 30, "top": 12, "bottom": 16},
  "config": {
    "font": "Source Sans 3, Source Sans Pro, sans-serif",
    "view": {"stroke": null},
    "axis": {"labelColor": "#1a1a1a", "labelFontSize": 12, "labelFontWeight": 600, "labelLimit": 280, "labelPadding": 8, "domain": false, "ticks": false}
  },
  "data": {"url": "data/derived_waffle.csv"},
  "transform": [
    {"calculate": "datum.tile_index + 0.92", "as": "tile_index_end"}
  ],
  "mark": {"type": "rect", "stroke": "#fbf8f2", "strokeWidth": 1.0, "cornerRadius": 0.5, "height": 14},
  "encoding": {
    "y": {
      "field": "category",
      "type": "nominal",
      "sort": {"field": "category_rank", "order": "ascending"},
      "axis": {"title": null, "orient": "left"}
    },
    "x": {
      "field": "tile_index",
      "type": "quantitative",
      "scale": {"domain": [-0.5, 135], "nice": false},
      "axis": null
    },
    "x2": {"field": "tile_index_end"},
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {"domain": ["expenditure", "spending"], "range": ["#a8302f", "#2d5e3f"]},
      "legend": {
        "title": null,
        "orient": "bottom-right",
        "labelFontSize": 11,
        "labelExpr": "datum.label == 'expenditure' ? 'Tax revenue forgone' : 'Direct federal spending'"
      }
    },
    "tooltip": [
      {"field": "category", "title": "Item"},
      {"field": "total_m", "title": "Annual amount ($m)", "format": ",d"},
      {"field": "total_bn", "title": "Annual amount ($bn)"},
      {"field": "tile_index", "title": "Tile number (each = $2B)"}
    ]
  }
}
