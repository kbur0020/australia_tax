{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top earners are remarkably consistent — except in two states",
    "subtitle": [
      "The five highest-earning occupations in each state, 2022-23. Surgeons, anaesthetists, and",
      "internal medicine specialists dominate seven of eight states. WA breaks the pattern.",
      "Source: ATO Taxation Statistics 2022-23, Snapshot Table 7C."
    ],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": 600,
    "subtitleFontSize": 12,
    "subtitleColor": "#5a5a5a",
    "subtitleLimit": 1200,
    "offset": 12
  },
  "background": "transparent",
  "padding": {"left": 20, "right": 20, "top": 12, "bottom": 16},
  "config": {
    "font": "Source Sans 3, Source Sans Pro, sans-serif",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 10, "titleFontSize": 11, "titleFontWeight": 500, "labelColor": "#3a3a3a"},
    "facet": {"spacing": {"row": 32, "column": 28}}
  },
  "data": {"url": "data/ato_top5_occupations_by_state.csv"},
  "columns": 2,
  "facet": {
    "field": "state",
    "type": "nominal",
    "sort": ["NSW","VIC","QLD","WA","SA","TAS","ACT","NT"],
    "header": {
      "title": null,
      "labelAngle": 0,
      "labelAnchor": "start",
      "labelAlign": "left",
      "labelFontSize": 13,
      "labelFontWeight": 700,
      "labelColor": "#1f4530",
      "labelPadding": 4
    }
  },
  "spec": {
    "width": 320,
    "height": 140,
    "mark": {"type": "bar", "cornerRadiusEnd": 2, "color": "#2d5e3f"},
    "encoding": {
      "y": {
        "field": "occupation_name",
        "type": "nominal",
        "sort": {"field": "avg_taxable_income", "order": "descending"},
        "axis": {"title": null, "labelLimit": 240, "labelFontSize": 10, "labelPadding": 6}
      },
      "x": {
        "field": "avg_taxable_income",
        "type": "quantitative",
        "axis": {"title": "Avg taxable income (AUD)", "format": "$,d", "labelExpr": "'$' + (datum.value/1000) + 'K'", "values": [0, 200000, 400000]},
        "scale": {"domain": [0, 600000]}
      },
      "tooltip": [
        {"field": "state", "title": "State"},
        {"field": "rank_state", "title": "Rank in state"},
        {"field": "occupation_name", "title": "Occupation"},
        {"field": "individuals", "title": "Number employed", "format": ",d"},
        {"field": "avg_taxable_income", "title": "Avg taxable income", "format": "$,.0f"},
        {"field": "median_taxable_income", "title": "Median taxable income", "format": "$,.0f"}
      ]
    }
  }
}
