{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which concessions are growing — and which are shrinking?",
    "subtitle": ["Each point is one tax concession. Horizontal axis: how big the concession is now (2025-26). Vertical axis: how fast it is projected to grow each year.", "Concessions in the top-right are large AND growing fast — they are the ones that will define the next decade. Source: Australian Treasury, TEIS 2025-26, Table 1.2."],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": 600,
    "subtitleFontSize": 12,
    "subtitleColor": "#5a5a5a",
    "offset": 12
  },
  "width": 700,
  "height": 460,
  "background": "transparent",
  "config": {
    "font": "Source Sans 3, Source Sans Pro, sans-serif",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 11, "titleFontSize": 12, "titleFontWeight": 500, "labelColor": "#3a3a3a"}
  },
  "data": {"url": "data/teis_large_tax_expenditures.csv"},
  "transform": [
    {"filter": "datum.revenue_forgone_m > 0 && datum.projected_growth_pct != null"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "stroke": "#d6c9b3", "strokeDash": [4, 4]},
      "encoding": {"y": {"datum": 0, "type": "quantitative"}}
    },
    {
      "mark": {"type": "circle", "opacity": 0.65, "stroke": "#fbf8f2", "strokeWidth": 1.2},
      "encoding": {
        "x": {
          "field": "revenue_forgone_m",
          "type": "quantitative",
          "scale": {"type": "log", "domain": [400, 40000]},
          "axis": {"title": "Revenue forgone 2025-26 (AUD millions, log scale)", "labelExpr": "datum.value >= 1000 ? '$' + (datum.value/1000) + 'B' : '$' + datum.value + 'M'", "values": [500, 1000, 2500, 5000, 10000, 25000]}
        },
        "y": {
          "field": "projected_growth_pct",
          "type": "quantitative",
          "scale": {"domain": [-6, 32]},
          "axis": {"title": "Projected annual growth (%)", "format": ".0f", "labelExpr": "datum.value + '%'"}
        },
        "size": {
          "field": "revenue_forgone_m",
          "type": "quantitative",
          "scale": {"range": [60, 1500]},
          "legend": null
        },
        "color": {
          "field": "tax_type",
          "type": "nominal",
          "scale": {
            "domain": ["Super", "CGT", "Income", "Deductions", "GST", "FBT", "Other"],
            "range": ["#1a3a5c", "#c1502e", "#7a5a2e", "#3f6a92", "#a17a44", "#5685ac", "#9a9a9a"]
          },
          "legend": {"title": "Tax type", "titleFontSize": 11, "labelFontSize": 10, "orient": "top-right", "symbolSize": 110}
        },
        "tooltip": [
          {"field": "title", "title": "Tax expenditure"},
          {"field": "code", "title": "Code"},
          {"field": "tax_type", "title": "Type"},
          {"field": "revenue_forgone_m", "title": "Revenue forgone 2025-26 ($m)", "format": ",d"},
          {"field": "projected_growth_pct", "title": "Projected growth (%)", "format": ".1f"},
          {"field": "avg_growth_2122_2425_pct", "title": "Recent growth (% pa)", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.revenue_forgone_m >= 9000 && datum.projected_growth_pct >= 5"}],
      "mark": {"type": "text", "fontSize": 10, "fontWeight": 600, "color": "#1a1a1a", "dy": -14, "align": "center"},
      "encoding": {
        "x": {"field": "revenue_forgone_m", "type": "quantitative"},
        "y": {"field": "projected_growth_pct", "type": "quantitative"},
        "text": {"field": "code"}
      }
    },
    {
      "transform": [{"filter": "datum.revenue_forgone_m >= 20000"}],
      "mark": {"type": "text", "fontSize": 10, "fontWeight": 600, "color": "#1a1a1a", "dy": -16, "align": "center"},
      "encoding": {
        "x": {"field": "revenue_forgone_m", "type": "quantitative"},
        "y": {"field": "projected_growth_pct", "type": "quantitative"},
        "text": {"field": "code"}
      }
    }
  ]
}
