{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Promised, then delivered: Budget vs reality, 2024-25",
    "subtitle": ["Each line connects what the government estimated it would spend (left) and what it actually spent (right).", "Health blew its target by $15 billion; Housing fell short by $9 billion. Source: Final Budget Outcome 2024-25."],
    "anchor": "start",
    "fontSize": 18,
    "fontWeight": 600,
    "subtitleFontSize": 12,
    "subtitleColor": "#5a5a5a",
    "offset": 12
  },
  "width": 580,
  "height": 460,
  "background": "transparent",
  "config": {
    "font": "Source Sans 3, Source Sans Pro, sans-serif",
    "view": {"stroke": null},
    "axis": {"labelFontSize": 11, "titleFontSize": 12, "titleFontWeight": 500, "labelColor": "#3a3a3a"}
  },
  "data": {"url": "data/fbo_2024_25_by_function_summary.csv"},
  "transform": [
    {"fold": ["fy24_25_estimate_m", "fy24_25_outcome_m"], "as": ["stage", "value_m"]},
    {"calculate": "datum.stage == 'fy24_25_estimate_m' ? 'Budget estimate' : 'Actual outcome'", "as": "stage_label"},
    {"calculate": "datum.value_m / 1000", "as": "value_bn"}
  ],
  "encoding": {
    "x": {
      "field": "stage_label",
      "type": "nominal",
      "sort": ["Budget estimate", "Actual outcome"],
      "axis": {"title": null, "labelFontSize": 12, "labelFontWeight": 600, "labelPadding": 8, "domain": false, "ticks": false, "orient": "top"}
    },
    "y": {
      "field": "value_bn",
      "type": "quantitative",
      "scale": {"type": "log"},
      "axis": {"title": "Spending (AUD billions, log scale)", "labelExpr": "'$' + datum.value + 'B'", "values": [1, 5, 10, 30, 100, 300]}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 1.5, "opacity": 0.75},
      "encoding": {
        "color": {
          "field": "change_vs_estimate_m",
          "type": "quantitative",
          "scale": {"domain": [-13000, 0, 16000], "range": ["#c1502e", "#a8a8a8", "#1a3a5c"]},
          "legend": {
            "title": "Variance ($m)",
            "titleFontSize": 10,
            "labelFontSize": 9,
            "orient": "bottom-right",
            "format": ",d",
            "gradientLength": 140
          }
        },
        "detail": {"field": "function"},
        "tooltip": [
          {"field": "function", "title": "Function"},
          {"field": "fy24_25_estimate_m", "title": "Budget estimate ($m)", "format": ",d"},
          {"field": "fy24_25_outcome_m", "title": "Actual outcome ($m)", "format": ",d"},
          {"field": "change_vs_estimate_m", "title": "Variance ($m)", "format": ",d"}
        ]
      }
    },
    {
      "mark": {"type": "circle", "size": 80, "stroke": "#fbf8f2", "strokeWidth": 1.5},
      "encoding": {
        "color": {
          "field": "change_vs_estimate_m",
          "type": "quantitative",
          "scale": {"domain": [-13000, 0, 16000], "range": ["#c1502e", "#a8a8a8", "#1a3a5c"]},
          "legend": null
        },
        "tooltip": [
          {"field": "function", "title": "Function"},
          {"field": "stage_label", "title": "Stage"},
          {"field": "value_m", "title": "Amount ($m)", "format": ",d"},
          {"field": "change_vs_estimate_m", "title": "Variance ($m)", "format": ",d"}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.stage_label == 'Actual outcome' && datum.value_m >= 30000"}
      ],
      "mark": {"type": "text", "fontSize": 10, "fontWeight": 500, "dx": 6, "align": "left", "color": "#1a1a1a"},
      "encoding": {
        "text": {"field": "function"}
      }
    }
  ]
}
